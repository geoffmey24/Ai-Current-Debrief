# Copy this file to .env and fill in your values.
# .env is gitignored and should NEVER be committed.

# --- AI ---
ANTHROPIC_API_KEY=

# --- LinkedIn (for scraping) ---
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# --- Email delivery ---
EMAIL_TO=                  # where to send the daily debrief
SMTP_USER=                 # your Gmail address (or SMTP login)
SMTP_PASSWORD=             # Gmail: use an App Password, NOT your account password
SMTP_HOST=smtp.gmail.com   # change if not using Gmail
SMTP_PORT=587
EMAIL_FROM=                # optional — defaults to SMTP_USER

# --- Misc ---
# Set to "false" to open a visible browser window (useful for solving LinkedIn 2FA)
HEADLESS=true

# --- Google OAuth (optional — for future Sheets/Slides deliverables) ---
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
