# ============================================================
# AI Current Debrief - Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# LinkedIn Credentials
# The account used to scrape company posts
# ------------------------------------------------------------
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# ------------------------------------------------------------
# Anthropic (Claude) API Key
# Get yours at: https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-...

# ------------------------------------------------------------
# Resend API Key (email delivery)
# Get yours at: https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY=re_...

# ------------------------------------------------------------
# Gmail Credentials (optional - for reference / future use)
# If you prefer Gmail SMTP over Resend, add these
# ------------------------------------------------------------
# GMAIL_USER=your_gmail@gmail.com
# GMAIL_APP_PASSWORD=your_app_password

# ------------------------------------------------------------
# Email Settings
# SENDER_EMAIL must be a verified domain in your Resend account
# RECIPIENT_EMAIL is where the briefing gets delivered
# ------------------------------------------------------------
SENDER_EMAIL=briefing@yourdomain.com
RECIPIENT_EMAIL=your_email@example.com
